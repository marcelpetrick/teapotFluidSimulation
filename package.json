{
  "name": "pourlab",
  "version": "0.13.10",
  "private": true,
  "description": "PourLab: browser 2D PIC/FLIP experiment showing where poured tea comes from and how much pouring mixes the pot.",
  "license": "GPL-3.0-or-later",
  "author": "Marcel Petrick <mail@marcelpetrick.it>",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "bench": "tsx benchmarks/run.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "5.1.0",
    "@webgpu/types": "0.1.74",
    "eslint": "10.14.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 110,
    "trailingComma": "all"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
